{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(aws * run-instances *)",
      "Bash(aws * start-instances *)",
      "Bash(aws * request-spot-instances *)",
      "Bash(aws * request-spot-fleet *)",
      "Bash(aws * create-fleet *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(aws * run-instances *)",
      "PowerShell(aws * start-instances *)",
      "PowerShell(aws * request-spot-instances *)",
      "PowerShell(aws * request-spot-fleet *)",
      "PowerShell(aws * create-fleet *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ask_before_publish.sh\""
          }
        ]
      }
    ]
  }
}
